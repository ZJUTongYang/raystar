<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>raystar_rviz_plugins</name>
  <version>0.2.0</version>
  <description>RViz2 Panel for Ray* single-goal and shared-tree multi-goal planning</description>
  <maintainer email="tong.yang@zju.edu.cn">Tong Yang</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend version_gte="11.2.0">rviz_common</depend>
  <depend version_gte="0.2.0">raystar_interfaces</depend>
  <depend>unique_identifier_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend version_gte="5.1.0">pluginlib</depend>

  <!-- The installed public Panel header and exported CMake target need the Qt
       development package; deployed binaries only need the shared libraries. -->
  <build_depend version_gte="5.15">qtbase5-dev</build_depend>
  <build_export_depend version_gte="5.15">qtbase5-dev</build_export_depend>
  <exec_depend>libqt5-core</exec_depend>
  <exec_depend>libqt5-widgets</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>rclcpp</test_depend>
  <test_depend>rclcpp_action</test_depend>
  <test_depend>raystar_interfaces</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>unique_identifier_msgs</test_depend>
  <test_depend>pluginlib</test_depend>
  <test_depend>rviz_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
