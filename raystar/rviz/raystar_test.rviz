        full_visreg_18: false
        full_visreg_19: false
        full_visreg_2: true
        full_visreg_20: false
        full_visreg_21: false
        full_visreg_22: false
        full_visreg_23: false
        full_visreg_24: false
        full_visreg_25: false
        full_visreg_26: false
        full_visreg_27: false
        full_visreg_28: false
        full_visreg_29: false
        full_visreg_3: true
        full_visreg_30: false
        full_visreg_31: false
        full_visreg_32: false
        full_visreg_33: false
        full_visreg_34: false
        full_visreg_35: false
        full_visreg_36: false
        full_visreg_4: true
        full_visreg_5: true
        full_visreg_6: true
        full_visreg_7: true
        full_visreg_8: true
        full_visreg_9: true
        node_0: true
        node_1: false
        node_10: false
        node_11: false
        node_12: false
        node_13: false
        node_14: false
        node_15: false
        node_16: false
        node_17: false
        node_18: false
        node_19: false
        node_2: false
        node_20: false
        node_21: false
        node_22: false
        node_23: false
        node_24: false
        node_25: false
        node_26: false
        node_27: false
        node_28: false
        node_29: false
        node_3: false
        node_30: false
        node_31: false
        node_32: false
        node_33: false
        node_34: false
        node_35: false
        node_36: false
        node_4: false
        node_5: false
        node_6: false
        node_7: false
        node_8: false
        node_9: false
        seeds: false
        tree_edges: false
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /raystar/debug_tree
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: CDT
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /raystar/cdt
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/PublishPoint
      Single click: false
      Topic: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Scale: 186.4063262939453
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 4.5
      Y: 5.5
    Saved: ~
